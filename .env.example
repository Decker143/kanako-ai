NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
KANAKO_AI_EXECUTION_ENABLED=false
KANAKO_AI_MODEL=openai/gpt-6-astra
# Optional for local development if Vercel OIDC is not configured:
# AI_GATEWAY_API_KEY=

# Optional web research provider. Keep disabled until a provider key and any required billing are approved.
BRAVE_SEARCH_API_KEY=
KANAKO_WEB_RESEARCH_ENABLED=false

# GitHub App integration. Store the PEM value as a Vercel Sensitive environment variable.
# Enable only after all three credentials are configured and the connection check succeeds.
KANAKO_GITHUB_EXECUTION_ENABLED=false
KANAKO_GITHUB_APP_ID=
KANAKO_GITHUB_INSTALLATION_ID=
KANAKO_GITHUB_APP_PRIVATE_KEY=
KANAKO_GITHUB_REPOSITORY=Decker143/kanako-ai
KANAKO_GITHUB_BASE_BRANCH=feature/task-center-register
